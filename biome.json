{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["**", "!pnpm-lock.yaml"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "yaml": {
        "formatter": {
            "indentWidth": 2
        }
    }
}
